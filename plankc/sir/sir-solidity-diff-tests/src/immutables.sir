immutable b1 1
immutable b7 7
immutable b20 20
immutable b32 32
immutable unused 5

fn init:
    entry {
        runtime_off = runtime_start_offset
        runtime_len = runtime_length
        buf = malloc runtime_len
        codecopy buf runtime_off runtime_len
        v1 = const 0xab
        setimmutable %b1 buf v1
        v7 = large_const 0x0102030405060f
        setimmutable %b7 buf v7
        v20 = caller
        setimmutable %b20 buf v20
        v32 = large_const 0xff0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
        setimmutable %b32 buf v32
        v_unused = const 0x1234
        setimmutable %unused buf v_unused
        return buf runtime_len
    }

fn main:
    entry {
        out = sallocany 288
        b1_a = getimmutable %b1
        mstore256 out b1_a
        b7_a = getimmutable %b7
        p1 = add out 32
        mstore256 p1 b7_a
        b20 = getimmutable %b20
        p2 = add out 64
        mstore256 p2 b20
        b32_a = getimmutable %b32
        p3 = add out 96
        mstore256 p3 b32_a
        b1_b = getimmutable %b1
        p4 = add out 128
        mstore256 p4 b1_b
        b7_b = getimmutable %b7
        p5 = add out 160
        mstore256 p5 b7_b
        b32_b = getimmutable %b32
        p6 = add out 192
        mstore256 p6 b32_b
        b7_c b1_c = icall @helper
        p7 = add out 224
        mstore256 p7 b7_c
        p8 = add out 256
        mstore256 p8 b1_c
        len = const 288
        return out len
    }

fn helper:
    entry -> b7 b1 {
        b7 = getimmutable %b7
        b1 = getimmutable %b1
        iret
    }
