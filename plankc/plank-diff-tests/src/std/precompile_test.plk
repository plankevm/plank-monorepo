import std::abi::abi_encode;
import std::constructor::return_runtime;
import std::core::addr::cast_addr;
import std::core::regions::*;
import std::precompile::{ecrecover, sha256, ripemd160, modexp};

const ECRECOVER_SELECTOR = 0xa489405c;
const RIPEMD160_SELECTOR = 0x31699b64;
const SHA256_SELECTOR = 0xb32a323d;
const MODEXP_SELECTOR = 0x725782ca;

const BytesResult = struct { data: bytes(memory) };

init {
    return_runtime();
}

run {
    let selector = unsafe_calldataload(rawptr(calldata) { raw: 0 }) >> 224;
    if selector == ECRECOVER_SELECTOR {
        call_ecrecover();
    } else if selector == SHA256_SELECTOR {
        call_sha256();
    } else if selector == RIPEMD160_SELECTOR {
        call_ripemd160();
    } else if selector == MODEXP_SELECTOR {
        call_modexp();
    } else {
        unsafe_revert(malloc_uninit(0), 0);
    }
}

const call_ecrecover = fn () never {
    let hash = unsafe_calldataload(rawptr(calldata) { raw: 4 });
    let v = unsafe_calldataload(rawptr(calldata) { raw: 36 });
    let r = unsafe_calldataload(rawptr(calldata) { raw: 68 });
    let s = unsafe_calldataload(rawptr(calldata) { raw: 100 });

    let account = ecrecover(hash, v, r, s);
    let out = malloc_uninit(32);
    let unwrapped = if account.is_some { cast_addr(account.inner, u256) } else { 0 };
    unsafe_mstore32(out, unwrapped);
    unsafe_return(out, 32);
};

const call_sha256 = fn () never {
    let offset = unsafe_calldataload(rawptr(calldata) { raw: 4 }) +% 4;
    let data = bytes_from_offset(offset);
    let hash = sha256(data);

    let out = malloc_uninit(32);
    unsafe_mstore32(out, hash);
    unsafe_return(out, 32);
};

const call_ripemd160 = fn () never {
    let offset = unsafe_calldataload(rawptr(calldata) { raw: 4 }) +% 4;
    let data = bytes_from_offset(offset);
    let hash = ripemd160(data);

    let out = malloc_uninit(32);
    unsafe_mstore32(out, hash);
    unsafe_return(out, 32);
};

const call_modexp = fn () never {
    let base_offset = unsafe_calldataload(rawptr(calldata) { raw: 4 }) +% 4;
    let exp_offset = unsafe_calldataload(rawptr(calldata) { raw: 36 }) +% 4;
    let mod_offset = unsafe_calldataload(rawptr(calldata) { raw: 68 }) +% 4;

    let base = bytes_from_offset(base_offset);
    let exp = bytes_from_offset(exp_offset);
    let mod = bytes_from_offset(mod_offset);

    let result = modexp(base, exp, mod);
    let out = abi_encode(BytesResult { data: result });
    unsafe_return(out.ptr, out.length);
};

const bytes_from_offset = fn (offset: u256) bytes(memory) {
    let length = unsafe_calldataload(rawptr(calldata) { raw: offset });
    let out = membytes_new(length);
    unsafe_calldatacopy(out.ptr, rawptr(calldata) { raw: offset +% 32 }, length);
    out
};
