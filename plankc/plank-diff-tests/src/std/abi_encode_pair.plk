import std::abi::{abi_encode, abi_decode};
import std::core::regions::*;

const Pair = struct { a: u256, b: u256 };

init {
    let size = @evm_calldatasize();
    let ptr = malloc_zeroed(size);
    unsafe_calldatacopy(ptr, rawptr(calldata) { raw: 0 }, size);
    let input = unsafe_bytes_from_parts(ptr, size);
    let decoded = abi_decode(Pair, input);
    let encoded = abi_encode(decoded);
    unsafe_return(encoded.ptr, encoded.length);
}
