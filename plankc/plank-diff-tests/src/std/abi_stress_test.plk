import std::abi::{abi_encode, abi_decode, abi_encoded_size};
import std::core::regions::*;

const Inner = struct { x: u256, data: bytes(memory) };
const Outer = struct { a: u256, b: bool, inner: Inner, c: bytes(memory) };

init {
    let size = @evm_calldatasize();
    let ptr = malloc_zeroed(size);
    unsafe_calldatacopy(ptr, rawptr(calldata) { raw: 0 }, size);
    let buf = unsafe_bytes_from_parts(ptr, size);
    let decoded = abi_decode(Outer, buf);
    let esize = abi_encoded_size(decoded);
    let encoded = abi_encode(decoded);
    let out_ptr = malloc_zeroed(32 +% encoded.length);
    unsafe_mstore32(out_ptr, esize);
    unsafe_mcopy(wrapping_add_bytes(out_ptr, 32), encoded.ptr, encoded.length);
    unsafe_return(out_ptr, 32 +% encoded.length);
}
