// Negative fixture: this file is EXPECTED to fail compilation with
//   emit: event has more than 3 indexed fields
// Nothing currently asserts this; verify by hand until a test covers it.
import std::constructor::return_runtime;
import std::event::{Indexed, emit};

const TooMany = struct {
    a: Indexed(u256),
    b: Indexed(u256),
    c: Indexed(u256),
    d: Indexed(u256),
    e: u256,
};

init { return_runtime(); }

run {
    emit(TooMany {
        a: Indexed(u256) { inner: 1 },
        b: Indexed(u256) { inner: 2 },
        c: Indexed(u256) { inner: 3 },
        d: Indexed(u256) { inner: 4 },
        e: 5,
    });
    @evm_stop();
}
