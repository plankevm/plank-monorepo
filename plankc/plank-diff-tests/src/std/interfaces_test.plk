use std::core::interfaces::{AsPrimitive, supports};
use std::core::uint::{UInt, u64, is_uint};
use std::core::addr::addr;
use std::error::comptime_assert;

const Other = struct {};
const Unsupported = struct {};
const Tagged = struct 264 { value: u256 };

init {
    comptime {
        comptime_assert(supports(AsPrimitive, AsPrimitive) == AsPrimitive, "single interface match");
        comptime_assert(supports(Other, AsPrimitive) == void, "single interface mismatch");
        comptime_assert(supports(AsPrimitive, (AsPrimitive,)) == AsPrimitive, "single-element tuple match");
        comptime_assert(supports(Other, (AsPrimitive,)) == void, "single-element tuple mismatch");
        comptime_assert(supports(AsPrimitive, (AsPrimitive, Other)) == AsPrimitive, "first tuple member");
        comptime_assert(supports(Other, (AsPrimitive, Other)) == Other, "second tuple member");
        comptime_assert(supports(Unsupported, (AsPrimitive, Other)) == void, "missing tuple member");
        comptime_assert(supports(AsPrimitive, ()) == void, "empty supported tuple");
    };
    comptime {
        comptime_assert(UInt(256) == u256, "UInt(256) must be the primitive u256 type");
        comptime_assert(!is_uint(Tagged), "an oversized struct tag is not a UInt");
        let as_primitive = u64.impl(AsPrimitive);
        let value: u64 = (as_primitive.unchecked_from_raw)(34);
        let raw = (as_primitive.to_raw)(value);
        comptime_assert(raw == 34, "u64 conversion must preserve the raw value");
        comptime_assert(as_primitive.byte_size == 8, "u64 must occupy 8 bytes");
        comptime_assert(UInt(7).impl(AsPrimitive).byte_size == 1, "7 bits must occupy 1 byte");
        comptime_assert(UInt(9).impl(AsPrimitive).byte_size == 2, "9 bits must occupy 2 bytes");
    };
    comptime {
        let as_primitive = addr.impl(AsPrimitive);
        let expected = 0x1234567890abcdef1234567890abcdef12345678;
        let value: addr = (as_primitive.unchecked_from_raw)(expected);
        let raw = (as_primitive.to_raw)(value);
        comptime_assert(raw == expected, "address conversion must preserve the raw value");
        comptime_assert(as_primitive.byte_size == 20, "address must occupy 20 bytes");
    };
    @evm_stop();
}
