import std::core::uint::*;
import std::core::addr::*;
import std::fixedbytes::bytes32;
import std::membytes::{membytes_from_ptr, membytes_read_u256};
import std::regions::*;
import std::option::unwrap;
import std::math::ceil32;

const is_abi_dynamic = fn (comptime T: type) bool {
    if comptime { is_uint(T) } {
        return false;
    }
    if T == bool or T == addr or T == bytes32 {
        return false;
    }
    if is_bytes(T) {
        return true;
    }
    if @is_struct(T) or @is_tuple(T) {
        comptime let mut i = 0;

        inline while i < @field_count(T) {
            if comptime { is_abi_dynamic(@field_type(T, i)) } {
                return true;
            }
            i = i + 1;
        }

        return false;
    }

    @compile_error("is_abi_dynamic: unsupported type for ABI encoding")
};

const abi_head_size = fn (comptime T: type) u256 {
    if comptime { is_uint(T) } {
        return 32;
    }

    if T == bool or T == addr or T == bytes32 {
        return 32;
    }

    if is_bytes(T) {
        return 32;
    }

    if @is_struct(T) or @is_tuple(T) {
        comptime let mut total_head_size = 0;
        comptime let mut i = 0;

        inline while i < @field_count(T) {
            let field_type = @field_type(T, i);
            let field_size = comptime {
                if is_abi_dynamic(field_type) { 32 } else { abi_head_size(field_type) }
            };
            total_head_size = total_head_size + field_size;
            i = i + 1;
        }

        return total_head_size;
    }

    @compile_error("abi_head_size: unsupported type for ABI encoding")
};

// ABI-encodes `value` of type `T` into `buf` starting at `offset`.
// Returns the number of bytes written.
// Caller must ensure `buf` is large enough for the full encoding (use `abi_encoded_size`).
const unsafe_abi_encode_to = fn (ptr: u256, offset: u256, value: $T) u256 {
    if comptime { is_uint(T) } {
        @mstore32(ptr +% offset, cast_uint(value, u256));
        return 32;
    }
    if T == bool {
        @mstore32(ptr +% offset, if value { 1 } else { 0 });
        return 32;
    }
    if T == addr {
        @mstore32(ptr +% offset, cast_addr(value, u256));
        return 32;
    }
    if T == bytes(memory) {
        @mstore32(ptr +% offset, value.length);
        @mcopy(ptr +% offset +% 32, value.ptr, value.length);
        // padding after value.length is left uninitialized; consumers only read length bytes
        return 32 + ceil32(value.length);
    }
    if @is_struct(T) or @is_tuple(T) {
        let mut head_offset = offset;
        let mut tail_offset = offset + abi_head_size(T);
        comptime let mut i = 0;

        inline while i < @field_count(T) {
            if comptime { is_abi_dynamic(@field_type(T, i)) } {
                @mstore32(ptr +% head_offset, tail_offset - offset);
                let written = unsafe_abi_encode_to(
                    ptr,
                    tail_offset,
                    @get_field(value, i)
                );
                head_offset = head_offset + 32;
                tail_offset = tail_offset + written;
            } else {
                let written = unsafe_abi_encode_to(
                    ptr,
                    head_offset,
                    @get_field(value, i)
                );
                head_offset = head_offset + written;
            }
            i = i + 1;
        }

        return tail_offset - offset;
    }


    @compile_log(T);
    @compile_error("unsafe_abi_encode_to: unsupported type for ABI encoding")
};

// ABI-decodes a value of type `T` from `buf` starting at `offset`.
// Caller must ensure `buf` contains valid ABI-encoded data for type `T`.
const unsafe_abi_decode_from = fn (comptime T: type, buf: u256, offset: u256) T {
    if T == void {
        ()
    } else if T == u256 {
        @mload32(buf +% offset)
    } else if T == bool {
        @mload32(buf +% offset) != 0
    } else if T == bytes(memory) {
        let length = @mload32(buf +% offset);
        membytes_from_ptr(buf +% offset +% 32, length)
    } else if @is_struct(T) {
        let mut head_offset = offset;
        let mut decoded_value = @uninit(T);
        comptime let mut i = 0;

        inline while i < @field_count(T) {
            let field_type = @field_type(T, i);
            if comptime { is_abi_dynamic(field_type) } {
                let tail_offset = offset + @mload32(buf +% head_offset);
                let decoded = unsafe_abi_decode_from(field_type, buf, tail_offset);
                head_offset = head_offset + 32;
                decoded_value = @set_field(decoded_value, i, decoded);
            } else {
                let decoded = unsafe_abi_decode_from(field_type, buf, head_offset);
                head_offset = head_offset + abi_head_size(field_type);
                decoded_value = @set_field(decoded_value, i, decoded);
            }
            i = i + 1;
        }

        decoded_value
    } else {
        @compile_error("unsupported type for ABI decoding")
    }
};

// Checks whether `buf` starting at `offset` is large enough to hold a valid ABI encoding of type `T`.
const abi_buf_fits = fn (comptime T: type, buf: bytes(memory), offset: u256) bool {
    if T == void {
        true
    } else if T == u256 {
        buf.length >= offset + 32
    } else if T == bool {
        buf.length >= offset + 32
    } else if T == bytes(memory) {
        let len_opt = membytes_read_u256(buf, offset);
        if !len_opt.is_some { return false; }
        let length = len_opt.inner;
        buf.length >= offset + 32 + ceil32(length)
    } else if @is_struct(T) {
        if offset + abi_head_size(T) > buf.length {
            return false;
        } 
        let mut head_offset = offset;
        comptime let mut i = 0;

        inline while i < @field_count(T) {
            let field_type = @field_type(T, i);
            if comptime { is_abi_dynamic(field_type) } {
                // Safe to unwrap: the pre-check above guarantees the entire head section is readable.
                let tail_offset = offset + unwrap(membytes_read_u256(buf, head_offset));
                if !abi_buf_fits(field_type, buf, tail_offset) {
                    return false;
                }
                head_offset = head_offset + 32;
            } else {
                head_offset = head_offset + abi_head_size(field_type);
            }
            i = i + 1;
        }

        true
    } else {
        @compile_error("unsupported type for ABI decoding")
    }
};
