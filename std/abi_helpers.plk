import std::membytes::{membytes, membytes_from_ptr, unsafe_membytes_write_u256, unsafe_membytes_read_u256};
import std::math::ceil32;
import std::utils::reduce;

const EncodeState = fn (comptime T: type) type {
    struct {
        buf: membytes,
        base_offset: u256,
        value: T,
        head_offset: u256,
        tail_offset: u256
    }
};

const DecodeState = fn (comptime T: type) type {
    struct {
        buf: membytes,
        base_offset: u256,
        head_offset: u256,
        result: T
    }
};

const ValidState = struct {
    buf: membytes,
    base_offset: u256,
    head_offset: u256,
    valid: bool
};

const is_abi_dynamic = fn (comptime T: type) bool {
    if T == void {
        false
    } else if T == u256 {
        false
    } else if T == bool {
        false
    } else if T == membytes {
        true
    } else if @is_struct(T) {
        reduce(
        bool,
        @field_count(T),
        fn (comptime i: u256, found: bool) bool {
            if found {
                true
            } else {
                is_abi_dynamic(@field_type(T, i))
            }
        },
        false
    )
    } else {
        let _sizeof_unsupported_type: u256 = true;
        false
    }
};

const abi_head_size = fn (comptime T: type) u256 {
    if T == void {
        0
    } else if T == u256 {
        32
    } else if T == bool {
        32
    } else if T == membytes {
        32
    } else if @is_struct(T) {
        reduce(
            u256,
            @field_count(T),
            fn (comptime i: u256, acc: u256) u256 {
                if is_abi_dynamic(@field_type(T, i)) {
                    @evm_add(acc, 32)
                } else {
                    @evm_add(acc, abi_head_size(@field_type(T, i)))
                }
            },
            0
        )
    } else {
        let _sizeof_unsupported_type: u256 = true;
        0
    }
};

const unsafe_abi_encode_to = fn (comptime T: type, buf: membytes, offset: u256, value: T) u256 {
    if T == void {
        0
    } else if T == u256 {
        unsafe_membytes_write_u256(buf, offset, value);
        32
    } else if T == bool {
        unsafe_membytes_write_u256(buf, offset, if value { 1 } else { 0 });
        32
    } else if T == membytes {
        unsafe_membytes_write_u256(buf, offset, value.len);
        @mcopy(@evm_add(buf.ptr, @evm_add(offset, 32)), value.ptr, value.len);
        // padding after value.len is left uninitialized; consumers only read len bytes
        @evm_add(32, ceil32(value.len))
    } else if @is_struct(T) {
        let initial = EncodeState(T) {
            buf: buf,
            base_offset: offset,
            value: value,
            head_offset: offset,
            tail_offset: @evm_add(offset, abi_head_size(T))
        };
        let result = reduce(
            EncodeState(T),
            @field_count(T),
            fn (comptime i: u256, state: EncodeState(T)) EncodeState(T) {
                let is_dynamic = is_abi_dynamic(@field_type(T, i));
                let write_at = if is_dynamic {
                    // write offset pointer relative to start of this struct's encoding
                    unsafe_membytes_write_u256(
                        state.buf,
                        state.head_offset,
                        @evm_sub(state.tail_offset, state.base_offset)
                    );
                    state.tail_offset
                } else {
                    state.head_offset
                };
                let written = unsafe_abi_encode_to(
                    @field_type(T, i),
                    state.buf,
                    write_at,
                    @get_field(state.value, i)
                );
                let mut s = state;
                if is_dynamic {
                    s = @set_field(s, 3, @evm_add(state.head_offset, 32));
                    s = @set_field(s, 4, @evm_add(state.tail_offset, written));
                } else {
                    s = @set_field(s, 3, @evm_add(state.head_offset, written));
                }
                s
            },
            initial
        );
        @evm_sub(result.tail_offset, offset)
    } else {
        let _sizeof_unsupported_type: u256 = true;
        0
    }
};

const unsafe_abi_decode_from = fn (comptime T: type, buf: membytes, offset: u256) T {
    if T == void {
        void
    } else if T == u256 {
        unsafe_membytes_read_u256(buf, offset)
    } else if T == bool {
        !@evm_iszero(unsafe_membytes_read_u256(buf, offset))
    } else if T == membytes {
        let len = unsafe_membytes_read_u256(buf, offset);
        membytes_from_ptr(@evm_add(buf.ptr, @evm_add(offset, 32)), len)
    } else if @is_struct(T) {
        let initial = DecodeState(T) {
            buf: buf,
            base_offset: offset,
            head_offset: offset,
            result: @uninit(T)
        };
        let result = reduce(
            DecodeState(T),
            @field_count(T),
            fn (comptime i: u256, state: DecodeState(T)) DecodeState(T) {
                let read_at = if is_abi_dynamic(@field_type(T, i)) {
                    @evm_add(
                        state.base_offset,
                        unsafe_membytes_read_u256(state.buf, state.head_offset)
                    )
                } else {
                    state.head_offset
                };
                let decoded = unsafe_abi_decode_from(
                    @field_type(T, i),
                    state.buf,
                    read_at
                );
                let mut s = state;
                s = @set_field(s, 2, @evm_add(state.head_offset, abi_head_size(@field_type(T, i))));
                s = @set_field(s, 3, @set_field(state.result, i, decoded));
                s
            },
            initial
        );
        result.result
    } else {
        let _sizeof_unsupported_type: u256 = true;
        void 
    }
};

const abi_buf_fits = fn (comptime T: type, buf: membytes, offset: u256) bool {
    if T == void {
        true
    } else if T == u256 {
        !@evm_gt(@evm_add(offset, 32), buf.len)
    } else if T == bool {
        !@evm_gt(@evm_add(offset, 32), buf.len)
    } else if T == membytes {
        if @evm_gt(@evm_add(offset, 32), buf.len) {
            return false;
        }
        let len = unsafe_membytes_read_u256(buf, offset);
        !@evm_gt(@evm_add(@evm_add(offset, 32), ceil32(len)), buf.len)
    } else if @is_struct(T) {
        if @evm_gt(@evm_add(offset, abi_head_size(T)), buf.len) {
            return false;
        } 
        let initial = ValidState {
            buf: buf,
            base_offset: offset,
            head_offset: offset,
            valid: true
        };
        let result = reduce(
            ValidState,
            @field_count(T),
            fn (comptime i: u256, state: ValidState) ValidState {
                if !state.valid {
                    return state;
                }
                if is_abi_dynamic(@field_type(T, i)) {
                    let validate_at = @evm_add(
                        state.base_offset,
                        unsafe_membytes_read_u256(state.buf, state.head_offset)
                    );
                    let valid = abi_buf_fits(@field_type(T, i), state.buf, validate_at);
                    let mut s = state;
                    s = @set_field(s, 2, @evm_add(state.head_offset, 32));
                    s = @set_field(s, 3, valid);
                    s
                } else {
                    let mut s = state;
                    s = @set_field(s, 2, @evm_add(state.head_offset, abi_head_size(@field_type(T, i))));
                    s
                }
            },
            initial
        );
        result.valid
    } else {
        let _sizeof_unsupported_type: u256 = true;
        false 
    }
};
