import std::membytes::membytes;
import std::utils::reduce;

const is_abi_dynamic = fn (comptime T: type) bool {
    if T == membytes { return true; }
    if !@is_struct(T) { return false; }
    reduce(bool, @field_count(T), fn (comptime i: u256, found: bool) bool {
        if found { true } else { is_abi_dynamic(@field_type(T, i)) }
    }, false)
};

const abi_head_size = fn (comptime T: type) u256 {
    if !@is_struct(T) {
        return 32;
    }
    reduce(u256, @field_count(T), fn (comptime i: u256, acc: u256) u256 {
        if is_abi_dynamic(@field_type(T, i)) {
            @evm_add(acc, 32)
        } else {
            @evm_add(acc, abi_head_size(@field_type(T, i)))
        }
    }, 0)
};
