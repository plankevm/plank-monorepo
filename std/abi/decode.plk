import std::option::{Option, Some, None, unwrap};
import std::membytes::{membytes, membytes_from_ptr, unsafe_membytes_read_u256};
import std::abi::helpers::{is_abi_dynamic, abi_head_size};
import std::utils::reduce;

const DecodeState = fn (comptime T: type) type {
    struct { buf: membytes, offset: u256, head_offset: u256, result: T }
};

// Core decoding function. Reads the ABI encoding of type T from `buf` at `offset`.
// Returns the decoded value.
const unsafe_abi_decode_from = fn (comptime T: type, buf: membytes, offset: u256) T {
    // membytes: read length from tail, then reference the data
    if T == membytes {
        let len = unsafe_membytes_read_u256(buf, offset);
        return membytes_from_ptr(@evm_add(buf.ptr, @evm_add(offset, 32)), len);
    }
    // primitive
    if !@is_struct(T) {
        if T == bool {
            return !@evm_iszero(unsafe_membytes_read_u256(buf, offset));
        } else if T == u256 {
            return unsafe_membytes_read_u256(buf, offset);
        }
    }
    // struct: read head, follow offsets for dynamic fields
    let result = reduce(DecodeState(T), @field_count(T), fn (comptime i: u256, state: DecodeState(T)) DecodeState(T) {
        if is_abi_dynamic(@field_type(T, i)) {
            let data_offset = @evm_add(state.offset, unsafe_membytes_read_u256(state.buf, state.head_offset));
            @set_field(
                @set_field(state, 2, @evm_add(state.head_offset, 32)),
                3, @set_field(state.result, i, unsafe_abi_decode_from(@field_type(T, i), state.buf, data_offset))
            )
        } else {
            @set_field(
                @set_field(state, 2, @evm_add(state.head_offset, abi_head_size(@field_type(T, i)))),
                3, @set_field(state.result, i, unsafe_abi_decode_from(@field_type(T, i), state.buf, state.head_offset))
            )
        }
    }, DecodeState(T) { buf: buf, offset: offset, head_offset: offset, result: @uninit(T) });
    result.result
};

const ValidState = struct { buf: membytes, offset: u256, head_offset: u256, valid: bool };

// Validates that `buf` contains valid ABI-encoded data of type T starting at `offset`.
const is_abi_valid = fn (comptime T: type, buf: membytes, offset: u256) bool {
    // membytes: need 32 bytes for length, then length bytes for data
    if T == membytes {
        if @evm_gt(@evm_add(offset, 32), buf.len) { return false; }
        let len = unsafe_membytes_read_u256(buf, offset);
        return !@evm_gt(@evm_add(@evm_add(offset, 32), len), buf.len);
    }
    // primitive: need 32 bytes
    if !@is_struct(T) {
        return !@evm_gt(@evm_add(offset, 32), buf.len);
    }
    // struct: validate head fits, then validate each field
    if @evm_gt(@evm_add(offset, abi_head_size(T)), buf.len) { return false; }
    let result = reduce(ValidState, @field_count(T), fn (comptime i: u256, state: ValidState) ValidState {
        if !state.valid { return state; }
        if is_abi_dynamic(@field_type(T, i)) {
            let data_offset = @evm_add(state.offset, unsafe_membytes_read_u256(state.buf, state.head_offset));
            @set_field(
                @set_field(state, 2, @evm_add(state.head_offset, 32)),
                3, is_abi_valid(@field_type(T, i), state.buf, data_offset)
            )
        } else {
            @set_field(
                @set_field(state, 2, @evm_add(state.head_offset, abi_head_size(@field_type(T, i)))),
                3, is_abi_valid(@field_type(T, i), state.buf, state.head_offset)
            )
        }
    }, ValidState { buf: buf, offset: offset, head_offset: offset, valid: true });
    result.valid
};

const unsafe_abi_decode = fn (comptime T: type, ptr: memptr, len: u256) T {
    let buf = membytes_from_ptr(ptr, len);
    unsafe_abi_decode_from(T, buf, 0)
};

const abi_decode_try = fn (comptime T: type, buf: membytes) Option(T) {
    if !is_abi_valid(T, buf, 0) {
        return None(T);
    }
    Some(T, unsafe_abi_decode_from(T, buf, 0))
};

const abi_decode = fn (comptime T: type, buf: membytes) T {
    unwrap(T, abi_decode_try(T, buf))
};
