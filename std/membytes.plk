import std::mem::unsafe_mem_write;
import std::option::{Option, Some, None};
import std::type::sizeof;
import std::regions::*;

const membytes = bytes(memory);

// Allocates a new zero-initialized buffer of `len` bytes.
const membytes_new = fn (len: u256) membytes {
    membytes { ptr: @malloc_zeroed(len), length: len }
};

// Wraps an existing pointer and length into a membytes.
// Caller must ensure the region [ptr, ptr + len) is valid.
const membytes_from_ptr = fn (ptr: u256, len: u256) membytes {
    membytes { ptr: ptr, length: len }
};

// Reads a u256 from `offset`. Returns None if out of bounds.
const membytes_read_u256 = fn (buf: membytes, offset: u256) Option(u256) {
    if (buf.length < 32) | (offset > buf.length -% 32)  {
        return None(u256);
    }
    Some(@mload32(buf.ptr +% offset))
};

// Writes a value of any type T at `offset`. Returns None if out of bounds.
const membytes_write = fn (buf: membytes, offset: u256, value: $T) bool {
    let size = comptime { sizeof(T) };
    if (buf.length < size) | (offset > buf.length -% size) {
        return false;
    }
    unsafe_mem_write(buf.ptr +% offset, value);
    true
};
