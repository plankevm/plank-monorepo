import std::fixedbytes::bytes32;
import std::membytes::{membytes, membytes_new};
import std::option::Option;

const addr = struct { raw: u256 };

const addr_from_u256 = fn (raw: u256) addr {
    if raw >= (1 << 160) {
        if @in_comptime() {
            let _raw_cannot_fit_addr: void = true;
        } else {
            @evm_revert(@malloc_uninit(0), 0);
        }
    }
    addr { raw: raw }
};

const msg_sender = fn () addr {
    addr { raw: @evm_caller() }
};

const tx_origin = fn () addr {
    addr { raw: @evm_origin() }
};

const raw_create = fn (value: u256, code: membytes) addr {
    let account = @evm_create(value, code.ptr, code.len);
    addr { raw: account }
};

const raw_create2 = fn (value: u256, code: membytes, salt: bytes32) addr {
    let account = @evm_create(value, code.ptr, code.len, salt.raw);
    addr { raw: account }
};

const raw_call = fn (
    target: addr,
    value: u256,
    gas: u256,
    calldata: membytes,
    return_buf: Option(membytes)
) bool {
    if return_buf.is_some {
        @evm_call(
            gas,
            target.raw,
            value,
            calldata.ptr,
            calldata.len,
            return_buf.inner.ptr,
            return_buf.inner.len
        )
    } else {
        @evm_call(gas, target.raw, value, calldata.ptr, calldata.len, 0, 0)
    }
};

const raw_staticcall = fn (
    target: addr,
    value: u256,
    gas: u256,
    calldata: membytes,
    return_buf: Option(membytes)
) bool {
    if return_buf.is_some {
        @evm_staticcall(
            gas,
            target.raw,
            value,
            calldata.ptr,
            calldata.len,
            return_buf.inner.ptr,
            return_buf.inner.len
        )
    } else {
        @evm_staticcall(gas, target.raw, value, calldata.ptr, calldata.len, 0, 0)
    }
};

const raw_delegatecall = fn (
    delegate: addr,
    value: u256,
    gas: u256,
    calldata: membytes,
    return_buf: Option(membytes)
) bool {
    if return_buf.is_some {
        @evm_delegatecall(
            gas,
            delegate.raw,
            value,
            calldata.ptr,
            calldata.len,
            return_buf.inner.ptr,
            return_buf.inner.len
        )
    } else {
        @evm_delegatecall(gas, delegate.raw, value, calldata.ptr, calldata.len, 0, 0)
    }
};
