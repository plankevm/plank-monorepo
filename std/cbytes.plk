import std::types::sizeof;
import std::error::comptime_assert;

const encode_cbytes = fn (comptime value: $T) cbytes {
    if T == void {
        ""
    } else if T == u256 {
        @concat_cbytes((value,))
    } else if T == bool {
        @concat_cbytes((if value { 1 } else { 0 },))
    } else if @is_struct(T) or @is_tuple(T) {
        let mut encoded = "";
        let mut i = 0;

        while i < @field_count(T) {
            encoded = @concat_cbytes((encoded, encode_cbytes(@get_field(value, i))));
            i = i + 1;
        }

        encoded
    } else {
        @compile_error("unsupported type for encode_cbytes")
    }
};

const unsafe_cbytes_read = fn (comptime T: type, comptime data: cbytes, comptime offset: u256) T {
    if T == void {
        return ();
    }
    if T == u256 {
        return @padded_read_cbytes(data, offset);
    }
    if T == bool {
        let is_true = data == encode_cbytes(true);
        let is_false = data == encode_cbytes(false);
        comptime_assert(is_true or is_false, "unsafe_cbytes_read: invalid encoding of `bool`");
        return is_true;
    }

    comptime_assert(@is_struct(T) or @is_tuple(T), "unsafe_cbytes_read: unsupported type `T`");

    comptime {
        let mut value = @uninit(T);
        let mut i = 0;
        let mut field_offset = 0;

        while i < @field_count(T) {
            let field_type = @field_type(T, i);
            let field_value = unsafe_cbytes_read(field_type, data, offset + field_offset);
            value = @set_field(value, i, field_value);
            field_offset = field_offset + sizeof(field_type);
            i = i + 1;
        }

        value
    }
};
