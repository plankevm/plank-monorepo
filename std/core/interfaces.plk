const AsPrimitive = struct {
    /// Encoded width in bytes, from 0 to 32.
    byte_size: u256,

    /// Takes a value of the implementing type and returns its u256 representation.
    /// The result must fit in byte_size bytes; encoding is big-endian.
    to_raw: function,

    /// Takes a u256 representation and returns the implementing type.
    /// The caller must ensure the input is valid for that type.
    unchecked_from_raw: function,
};

/// Returns the requested type if supported, otherwise `void`.
/// Accepts a single type or a tuple of types.
const supports = fn (comptime requested: type, comptime supported: $L) type {
    if L == type {
        return if requested == supported { requested } else { void };
    }
    if !@is_tuple(L) {
        @compile_error("supported interfaces must be a type or a tuple of types");
    }

    let mut i = 0;
    while i < @field_count(L) {
        let interface: type = @get_field(supported, i);
        if requested == interface {
            return requested;
        }
        i = i +% 1;
    }

    void
};
