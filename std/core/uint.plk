import std::option::*;

const UInt = fn (comptime Size: u256) type {
    if Size <= 0 or 256 < Size {
        @compile_error("UInt: `Size` must be between 1-256");
    }

    if Size == 256 {
        return u256;
    }

    struct Size {
        _raw_repr: u256
    }
};

const u8  = UInt(8);
const u16 = UInt(16);
const u24 = UInt(24);
const u32 = UInt(32);
const u40 = UInt(40);
const u48 = UInt(48);
const u56 = UInt(56);
const u64 = UInt(64);
const u72 = UInt(72);
const u80 = UInt(80);
const u88 = UInt(88);
const u96 = UInt(96);
const u104 = UInt(104);
const u112 = UInt(112);
const u120 = UInt(120);
const u128 = UInt(128);
const u136 = UInt(136);
const u144 = UInt(144);
const u152 = UInt(152);
const u160 = UInt(160);
const u168 = UInt(168);
const u176 = UInt(176);
const u184 = UInt(184);
const u192 = UInt(192);
const u200 = UInt(200);
const u208 = UInt(208);
const u216 = UInt(216);
const u224 = UInt(224);
const u232 = UInt(232);
const u240 = UInt(240);
const u248 = UInt(248);

const _type_of = fn (comptime _x: $T) type { T };

const is_uint = eager fn (comptime T: type) bool {
    if T == u256 {
        return true;
    }

    if !@is_struct(T) {
        return false;
    }

    let supposed_size = @type_index(T);
    _type_of(supposed_size) == u256 and UInt(supposed_size) == T
};

const bit_size = eager fn (comptime T: type) u256 {
    if T == u256 {
        return 256;
    }

    if !is_uint(T) {
        @compile_error("bit_size: `T` not `uN` type");
    }

    @type_index(T)
};

const unsafe_uint_from_u256 = eager fn (comptime T: type, raw_repr: u256) T {
    if T == u256 {
        raw_repr
    } else {
        T { _raw_repr: raw_repr }
    }
};

const repr_u256 = fn (comptime x: u256) cbytes {
    let digit = @slice_cbytes("0123456789", x % 10, x % 10 + 1);
    let remaining = x -/ 10;
    if remaining == 0 {
        return digit;
    }
    @concat_cbytes((repr_u256(remaining), digit))
};

const new_uint = eager fn (comptime T: type, comptime x: u256) T {
    if !is_uint(T) {
        @compile_error("new_uint: `T` not `uN` type");
    }
    if T == u256 {
        return x;
    }

    let size = bit_size(T);
    if x >= (1 << size) {
        @compile_error(@concat_cbytes(
            ("new_uint: ", repr_u256(x), " too large for u", repr_u256(size))
        ));
    }

    unwrap(try_cast_uint(x, u8))
};

const cast_uint = eager fn (src: $T, comptime Dst: type) Dst {
    if !is_uint(T) {
        @compile_error("cast_uint: `T` not `uN` type");
    }
    if !is_uint(Dst) {
        @compile_error("cast_uint: `Dst` not `uN` type");
    }
    if bit_size(T) > bit_size(Dst) {
        @compile_error("cast_uint: cannot infalliably cast `src` with larger bit size to `Dst`");
    }

    let repr = if T == u256 { src } else { src._raw_repr };

    unsafe_uint_from_u256(Dst, repr)
};

const try_cast_uint = eager fn (src: $T, comptime Dst: type) Option(Dst) {
    if !is_uint(T) {
        @compile_error("try_cast_uint: `T` not `uN` type");
    }
    if !is_uint(Dst) {
        @compile_error("try_cast_uint: `Dst` not `uN` type");
    }

    let dst_bit_size = comptime { bit_size(Dst) };
    if bit_size(T) <= dst_bit_size {
        return Some(cast_uint(src, Dst));
    }

    let raw_repr = cast_uint(src, u256);
    if (raw_repr >> dst_bit_size) != 0 {
        return None(Dst);
    }

    Some(unsafe_uint_from_u256(Dst, raw_repr))
};
