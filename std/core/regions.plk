import std::option::*;
import std::core::uint::*;
import std::fixedbytes::bytes32;

// TODO: Replace with a real enum.
const memory     = struct {};
const code       = struct {};
const calldata   = struct {};
const ctime      = struct {};
const returndata = struct {};
const transient  = struct {};
const storage    = struct {};

const is_region = eager fn (comptime R: $T) bool {
    if T != type {
        return false;
    }
    R == memory
    or R == code
    or R == calldata
    or R == ctime
    or R == returndata
    or R == transient
    or R == storage
};

const region_is_any_of = eager fn (comptime R1: type, comptime regions: $T) bool {
    if !is_region(R1) {
        @compile_error("region_is_any_of: `R1` not region");
    }
    if !@is_tuple(T) {
        @compile_error("region_is_any_of: expects tuple as `regions`");
    }
    let mut is_any = false;
    let mut i = 0;
    while i < @field_count(T) {
        let ri = @get_field(regions, i);
        if !is_region(ri) {
            @compile_error("region_is_any_of: `regions` contains non-region");
        }
        if R1 == ri {
            is_any = true;
        }
        i = i + 1;
    }
    is_any
};

const rawptr = fn (comptime R: type) type {
    if R == ctime {
        @compile_error("rawptr: `ctime` doesn't have a raw pointer representation");
    }

    if region_is_any_of(R, (memory, calldata, code, returndata)) {
        return struct R { raw: u256 };
    }

    if R == transient or R == storage {
        return struct R { slot: u256, bit: u8 };
    }

    @compile_error("rawptr: unexpected region kind `R`")
};

const rawptr_get_region = fn (comptime T: type) Option(type) {
    if T == rawptr(memory)     { return Some(memory); }
    if T == rawptr(calldata)   { return Some(calldata); }
    if T == rawptr(code)       { return Some(code); }
    if T == rawptr(returndata) { return Some(returndata); }
    if T == rawptr(storage)    { return Some(storage); }
    if T == rawptr(transient)  { return Some(transient); }
    None(type)
};

const malloc_uninit = fn (size: u256) rawptr(memory) {
    rawptr(memory) { raw: @malloc_uninit(size) }
};

const malloc_zeroed = fn (size: u256) rawptr(memory) {
    rawptr(memory) { raw: @malloc_zeroed(size) }
};

const unsafe_revert = fn (ptr: rawptr(memory), size: u256) never {
    @evm_revert(ptr.raw, size);
};

const unsafe_return = fn (ptr: rawptr(memory), size: u256) never {
    @evm_return(ptr.raw, size);
};

const unsafe_mstore32 = fn (ptr: rawptr(memory), word: u256) void {
    @mstore32(ptr.raw, word);
};

const unsafe_mload32 = fn (ptr: rawptr(memory)) u256 {
    @mload32(ptr.raw)
};

const unsafe_mload1 = fn (ptr: rawptr(memory)) u256 {
    @mload1(ptr.raw)
};

const unsafe_keccak256 = fn (ptr: rawptr(memory), size: u256) u256 {
    @evm_keccak256(ptr.raw, size)
};

const unsafe_calldataload = fn (ptr: rawptr(calldata)) u256 {
    @evm_calldataload(ptr.raw)
};

const rawptr_byte_addressable = eager fn (comptime T: type) bool {
    T == rawptr(memory)
    or T == rawptr(calldata)
    or T == rawptr(code)
    or T == rawptr(returndata)
};

const wrapping_add_bytes = fn (ptr: $T, offset: u256) T {
    T { raw: ptr.raw +% offset }
};

const unsafe_calldatacopy = fn (dst: rawptr(memory), src: rawptr(calldata), size: u256) void {
    @evm_calldatacopy(dst.raw, src.raw, size);
};

const unsafe_codecopy = fn (dst: rawptr(memory), src: rawptr(code), size: u256) void {
    @evm_codecopy(dst.raw, src.raw, size);
};

const unsafe_returndatacopy = fn (dst: rawptr(memory), src: rawptr(returndata), size: u256) void {
    @evm_returndatacopy(dst.raw, src.raw, size);
};

const unsafe_mcopy = fn (dst: rawptr(memory), src: rawptr(memory), size: u256) void {
    @mcopy(dst.raw, src.raw, size);
};

const unsafe_staticcall = fn (
    gas: u256,
    account: u256,
    input: rawptr(memory),
    input_size: u256,
    output: rawptr(memory),
    output_size: u256,
) bool {
    @evm_staticcall(gas, account, input.raw, input_size, output.raw, output_size)
};

const unsafe_create = fn (value: u256, init_code: rawptr(memory), size: u256) u256 {
    @evm_create(value, init_code.raw, size)
};

const unsafe_create2 = fn (value: u256, init_code: rawptr(memory), size: u256, salt: u256) u256 {
    @evm_create2(value, init_code.raw, size, salt)
};

const unsafe_log0 = fn (data: rawptr(memory), size: u256) void {
    @evm_log0(data.raw, size);
};

const unsafe_log1 = fn (data: rawptr(memory), size: u256, topic0: u256) void {
    @evm_log1(data.raw, size, topic0);
};

const unsafe_log2 = fn (data: rawptr(memory), size: u256, topic0: u256, topic1: u256) void {
    @evm_log2(data.raw, size, topic0, topic1);
};

const unsafe_log3 = fn (data: rawptr(memory), size: u256, topic0: u256, topic1: u256, topic2: u256) void {
    @evm_log3(data.raw, size, topic0, topic1, topic2);
};

const unsafe_log4 = fn (data: rawptr(memory), size: u256, topic0: u256, topic1: u256, topic2: u256, topic3: u256) void {
    @evm_log4(data.raw, size, topic0, topic1, topic2, topic3);
};

const embed_get_ptr = fn (comptime data: cbytes) rawptr(code) {
    rawptr(code) { raw: @data_offset(data) }
};

const bytes = fn (comptime R: type) type {
    if R == ctime {
        return cbytes;
    }
    if !is_region(R) {
        @compile_error("bytes: `R` is not a region");
    }
    return struct R { ptr: rawptr(R), length: u256 };
};

const string = fn (comptime R: type) type {
    if R == ctime {
        return struct R { data: cbytes };
    }
    if !is_region(R) {
        @compile_error("string: `R` is not a region");
    }
    return struct R { ptr: rawptr(R), length: u256 };
};

const unsafe_bytes_from_parts = fn (ptr: $T, length: u256)
    {
        let region = rawptr_get_region(T);
        if !region.is_some {
            @compile_error("unsafe_bytes_from_parts: `ptr` is not a `rawptr(R)`");
        }
        bytes(region.unsafe_unwrapped)
    }
{
    let region = comptime { rawptr_get_region(T).unsafe_unwrapped };
    bytes(region) { ptr: ptr, length: length }
};

const embed_as = fn (comptime data: cbytes, comptime R: type) bytes(R) {
    if R == code {
        return unsafe_bytes_from_parts(embed_get_ptr(data), data.length);
    }
    if R == memory {
        let ptr = malloc_uninit(data.length);
        unsafe_codecopy(ptr, embed_get_ptr(data), data.length);
        return unsafe_bytes_from_parts(ptr, data.length);
    }
    if R == calldata {
        @compile_error("cannot convert `cbytes` to `bytes(calldata)`; calldata is read-only");
    }
    if R == ctime {
        return data;
    }
    @compile_error("embed_as: unsupported region type");
};

const copy_if_not_already_memory = fn (data: $T) bytes(memory) {
    if T == bytes(ctime) {
        return embed_as(data, memory);
    }
    if T == bytes(calldata) {
        let ptr = malloc_uninit(data.length);
        unsafe_calldatacopy(ptr, data.ptr, data.length);
        return unsafe_bytes_from_parts(ptr, data.length);
    }
    if T == bytes(code) {
        let ptr = malloc_uninit(data.length);
        unsafe_codecopy(ptr, data.ptr, data.length);
        return unsafe_bytes_from_parts(ptr, data.length);
    }
    if T == bytes(returndata) {
        let ptr = malloc_uninit(data.length);
        unsafe_returndatacopy(ptr, data.ptr, data.length);
        return unsafe_bytes_from_parts(ptr, data.length);
    }
    if T == bytes(memory) {
        return data;
    }
    @compile_error("copy_if_not_already_memory: type of `data` is not supported");
};

const slice_bytes = fn (data: $T, start: u256, end: u256) T {
    if T == bytes(ctime) {
        return @slice_cbytes(data, start, end);
    }

    if T == bytes(calldata)
        or T == bytes(code)
        or T == bytes(returndata)
        or T == bytes(memory)
    {
        if !((start <= end) & (end <= data.length)) {
            unsafe_revert(malloc_uninit(0), 0);
        }
        return T {
            ptr: wrapping_add_bytes(data.ptr, start),
            length: end -% start
        };
    }

    @compile_error("slice_bytes: type of `data` is not supported");
};

const keccak256 = eager fn (data: $T) bytes32 {
    let raw_hash = if T == bytes(ctime) {
        @keccak256_cbytes(data)
    } else if T == bytes(memory) {
        unsafe_keccak256(data.ptr, data.length)
    } else if T == bytes(calldata) {
        let ptr = malloc_uninit(data.length);
        unsafe_calldatacopy(ptr, data.ptr, data.length);
        unsafe_keccak256(ptr, data.length)
    } else if T == bytes(code) {
        let ptr = malloc_uninit(data.length);
        unsafe_codecopy(ptr, data.ptr, data.length);
        unsafe_keccak256(ptr, data.length)
    } else if T == bytes(returndata) {
        let ptr = malloc_uninit(data.length);
        unsafe_returndatacopy(ptr, data.ptr, data.length);
        unsafe_keccak256(ptr, data.length)
    } else {
        @compile_error("keccak256: unsupported type");
    };
    bytes32 { raw: raw_hash }
};

const bytes_eq = eager fn (b1: $T1, b2: $T2) bool {
    if T1 == bytes(ctime) and T2 == bytes(ctime) {
        return b1 == b2;
    }
    b1.length == b2.length and keccak256(b1).raw == keccak256(b2).raw
};

const membytes_new = fn (size: u256) bytes(memory) {
    unsafe_bytes_from_parts(malloc_zeroed(size), size)
};



