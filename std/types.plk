const type_of = fn (comptime _x: $T) type { T };

const sizeof = fn (comptime T: type) u256 {
    if T == void {
        0
    } else if T == u256 {
        32
    } else if T == bool {
        32
    } else if @is_struct(T) or @is_tuple(T) {
        comptime let mut size = 0;
        comptime let mut i = 0;

        inline while i < @field_count(T) {
            size = size + comptime { sizeof(@field_type(T, i)) };
            i = i + 1;
        }

        size
    } else {
        @compile_error("unsupported type for sizeof")
    }
};
