import std::error::require;
import std::core::regions::*;
import std::option::{Option, Some, None};
import std::core::addr::*;

const ECRECOVER_ADDR = addr_from_u256(0x01);
const SHA256_ADDR = addr_from_u256(0x02);
const RIPEMD160_ADDR = addr_from_u256(0x03);
const IDENTITY_ADDR = addr_from_u256(0x04);
const MODEXP_ADDR = addr_from_u256(0x05);

const ecrecover = fn (hash: u256, v: u256, r: u256, s: u256) Option(addr) {
    let length = 128;
    let buf = malloc_uninit(length);
    unsafe_mstore32(wrapping_add_bytes(buf, 0), hash);
    unsafe_mstore32(wrapping_add_bytes(buf, 32), v);
    unsafe_mstore32(wrapping_add_bytes(buf, 64), r);
    unsafe_mstore32(wrapping_add_bytes(buf, 96), s);

    let success = unsafe_staticcall(@evm_gas(), cast_addr(ECRECOVER_ADDR, u256), buf, length, buf, 32);
    if success {
        Some(addr_from_u256(unsafe_mload32(buf)))
    } else {
        None(addr)
    }
};

const sha256 = fn (data: bytes(memory)) u256 {
    let length = 32;
    let buf = malloc_uninit(length);

    let success = unsafe_staticcall(@evm_gas(), cast_addr(SHA256_ADDR, u256), data.ptr, data.length, buf, length);
    require(success, ());

    unsafe_mload32(buf)
};

const ripemd160 = fn (data: bytes(memory)) u256 {
    let length = 32;
    let buf = malloc_uninit(length);

    let success = unsafe_staticcall(@evm_gas(), cast_addr(RIPEMD160_ADDR, u256), data.ptr, data.length, buf, length);
    require(success, ());

    unsafe_mload32(buf)
};

const modexp = fn (base: bytes(memory), exp: bytes(memory), mod: bytes(memory)) bytes(memory) {
    let length = 96 + base.length + exp.length + mod.length;
    let buf = malloc_uninit(length);

    unsafe_mstore32(wrapping_add_bytes(buf, 0), base.length);
    unsafe_mstore32(wrapping_add_bytes(buf, 32), exp.length);
    unsafe_mstore32(wrapping_add_bytes(buf, 64), mod.length);

    unsafe_mcopy(wrapping_add_bytes(buf, 96), base.ptr, base.length);
    unsafe_mcopy(wrapping_add_bytes(buf, 96 +% base.length), exp.ptr, exp.length);
    unsafe_mcopy(wrapping_add_bytes(buf, 96 +% base.length +% exp.length), mod.ptr, mod.length);

    let success = unsafe_staticcall(@evm_gas(), cast_addr(MODEXP_ADDR, u256), buf, length, buf, mod.length);
    require(success, ());

    unsafe_bytes_from_parts(buf, mod.length)
};
