import std::membytes::{membytes, membytes_from_ptr};
import std::option::{Option, Some, None};

const ECRECOVER_ADDR = 0x01;
const SHA256_ADDR = 0x02;
const RIPEMD160_ADDR = 0x03;
const IDENTITY_ADDR = 0x04;
const MODEXP_ADDR = 0x05;

const ecrecover = fn (hash: u256, v: u256, r: u256, s: u256) Option(u256) {
    let calldata = membytes_new_uninit(128);
    @mstore32(calldata.ptr +% 0, hash);
    @mstore32(calldata.ptr +% 32, v);
    @mstore32(calldata.ptr +% 64, r);
    @mstore32(calldata.ptr +% 96, s);

    let success = @evm_staticcall(
        @evm_gas(), 
        ECRECOVER_ADDR, 
        calldata.ptr, 
        calldata.len, 
        calldata.ptr, 
        32
    );
    require(success);
    
    let inner = @mload32(calldata.ptr);
    if inner != 0 {
        Some(u256, inner)
    } else {
        None(u256)
    }

};

const sha256 = fn (data: membytes) u256 {
    let returndata = membytes_new_uninit(32);
    let success = @evm_staticcall(
        @evm_gas(), 
        SHA256_ADDR, 
        data.ptr, 
        data.len, 
        returndata.ptr, 
        returndata.len
    );
    require(success);

    @mload32(returndata.ptr)
};

const ripemd160 = fn (data: membytes) u256 {
    let returndata = membytes_new_uninit(32);
    let success = @evm_staticcall(
        @evm_gas(), 
        RIPEMD160_ADDR, 
        data.ptr, 
        data.len, 
        returndata.ptr, 
        returndata.len
    );
    require(success);

    @mload32(returndata.ptr)
};

const set_returndata = fn (data: membytes) membytes {
    let returndata = membytes_new_uninit(data.len);
    let success = @evm_staticcall(
        @evm_gas(), 
        IDENTITY_ADDR, 
        data.ptr, 
        data.len, 
        returndata.ptr, 
        returndata.len
    );
    require(success);

    returndata
};

const modexp = fn (base: membytes, exp: membytes, mod: membytes) membytes {
    let len = 96 + base.len + exp.len + mod.len;
    let calldata = membytes_new_uninit(len);

    @mstore32(calldata.ptr +% 0, base.len);
    @mstore32(calldata.ptr +% 32, exp.len);
    @mstore32(calldata.ptr +% 64, mod.len);

    @mcopy(calldata.ptr +% 96, base.ptr, base.len);
    @mcopy(calldata.ptr +% 96 +% base.len, exp.ptr, exp.len);
    @mcopy(calldata.ptr +% 96 +% base.len +% exp.len, mod.ptr, mod.len);

    let success = @evm_staticcall(
        @evm_gas(), 
        MODEXP_ADDR, 
        calldata.ptr, 
        calldata.len, 
        calldata.ptr, 
        mod.len 
    );
    require(success);

    membytes_from_ptr(calldata.ptr, mod.len) 
};

const membytes_new_uninit = fn (len: u256) membytes {
    let ptr = @malloc_uninit(len);
    membytes_from_ptr(ptr, len)
};

const require = fn (success: bool) void {
    if !success {
        @evm_revert(@malloc_uninit(0), 0);
    }
};
