import std::option::{Option, Some, None};

const bytes32 = struct { raw: u256 };

const bytes32_from_u256 = fn (value: u256) bytes32 {
    bytes32 { raw: value }
};

// Reads a bytes32 from a memory bytes value at `offset`.
const membytes_read_bytes32 = fn (buf: $T, offset: u256) Option(bytes32) {
    let end_offset = offset +% 32;
    if (end_offset < offset) | (end_offset > buf.length) {
        return None(bytes32);
    }
    let raw = @mload32(buf.ptr.raw +% offset);
    Some(bytes32 { raw: raw })
};
