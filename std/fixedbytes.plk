import std::option::{Option, Some, None};
import std::membytes::membytes;
import std::mem::unsafe_mem_read_u256;

const bytes32 = struct { raw: u256 };

const bytes32_from_u256 = fn (raw: u256) bytes32 {
    bytes32 { raw: raw }
};

const try_into_bytes32 = fn (comptime T: type, value: T) Option(bytes32) {
    if T == u256 {
        bytes32_from_u256(value)
    } else if T == membytes {
        if value.len != 32 {
            return None(bytes32);
        }
        let raw = unsafe_mem_read_u256(value.ptr, 0);
        Some(bytes32, bytes32_from_u256(raw))
    } else {
        None(bytes32)
    }
};
