const Option = fn (comptime T: type) type {
    struct {
        inner: T,
        is_some: bool,
    }
};

const Some = fn (value: $T) Option(T) {
    Option(T) {
        inner: value,
        is_some: true,
    }
};

const None = fn (comptime T: type) Option(T) {
    Option(T) {
        inner: @uninit(T),
        is_some: false,
    }
};

const is_none = fn (comptime T: type, opt: Option(T)) bool {
    !opt.is_some
};

const get_option_type = fn (comptime T: type) Option(type) {
    if !@is_struct(T) or @field_count(T) != 2 or Option(@field_type(T, 0)) != T {
        return None(type);
    }
    Some(@field_type(T, 0))
};

const unwrap = fn (opt: $T) {
    let inner_type = get_option_type(opt);
    if !opt.is_some {
        @compile_error("unwrap: `opt` not a `Option(_)`");
    }
    inner_type.inner
} {
    if !opt.is_some {
        if @in_comptime() {
            @compile_error("unwrap: `opt` is `None`")
        } else {
            @evm_revert(@malloc_uninit(0), 0);
        }
    }
    opt.inner
};
