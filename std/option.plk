const Option = fn (comptime T: type) type {
    struct {
        unsafe_unwrapped: T,
        is_some: bool,
    }
};

const Some = eager fn (value: $T) Option(T) {
    Option(T) {
        unsafe_unwrapped: value,
        is_some: true,
    }
};

const None = eager fn (comptime T: type) Option(T) {
    Option(T) {
        unsafe_unwrapped: @uninit(T),
        is_some: false,
    }
};

const get_option_type = fn (comptime T: type) Option(type) {
    if !@is_struct(T) or @field_count(T) != 2 or Option(@field_type(T, 0)) != T {
        return None(type);
    }
    Some(@field_type(T, 0))
};

const unwrap = eager fn (opt: $T) {
    let inner_type = get_option_type(T);
    if !inner_type.is_some {
        @compile_error("unwrap: `opt` not an `Option(_)`");
    }
    inner_type.unsafe_unwrapped
} {
    if !opt.is_some {
        if @in_comptime() {
            @compile_error("unwrap: `opt` is `None`")
        } else {
            @evm_revert(@malloc_uninit(0), 0);
        }
    }
    opt.unsafe_unwrapped
};
