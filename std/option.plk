const Option = fn (comptime T: type) type {
    struct {
        inner: T,
        is_some: bool
    }
};

const Some = fn (value: $T) Option(T) {
    Option(T) { inner: value, is_some: true }
};

const None = fn (comptime T: type) Option(T) {
    Option(T) { inner: @uninit(T), is_some: false }
};

const is_some = fn (comptime T: type, opt: Option(T)) bool {
    opt.is_some
};

const is_none = fn (comptime T: type, opt: Option(T)) bool {
    !opt.is_some
};

const option_infer_inner = fn (comptime T: type) Option(type) {
    if !@is_struct(T) {
        return None(type);
    }
    let i = @field_index(T, "inner");
    if i >= @field_count(T) {
        return None(type);
    }
    let inner_type = @field_type(T, i);
    if T != Option(inner_type) {
        return None(type);
    }
    Some(inner_type)
};

const unwrap = fn (opt: $T) {
    let inner_type = option_infer_inner(T);
    if !inner_type.is_some {
        @compile_error("unwrap: `opt` not `Option(_)`");
    }
    inner_type.inner
} {
    if !opt.is_some {
        if @in_comptime() {
            @compile_error("unwrap: `opt` is `None`")
        } else {
            @evm_revert(@malloc_uninit(0), 0);
        }
    }
    opt.inner
};
